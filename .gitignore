# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local toolchains
.venv/
venv/
env/
.tools/

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# Test, coverage, lint, and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/
.hypothesis/

# Local Ratiocinatus workspaces, proof runs, exports, and qualification output
/.ratiocinatus/
/.demo/
/.demo-export/
/.phase0-proof/
/.phase0-export/
/.qualification/
/.verification/
/exports/
*.fixture.zip

# Downloaded model weights and provider caches are never repository assets
/.cache/
/models/
*.onnx
*.safetensors
*.gguf
*.ckpt
*.pth
*.pt

# Secrets and local configuration overrides
.env
.env.*
!.env.example
*.local.json
*.local.toml
*.local.yaml
*.local.yml

# Operational logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# Editors and operating systems
.idea/
.vscode/
.vs/
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/