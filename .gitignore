# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local toolchains
.venv/
venv/
env/
.tools/

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl

# Test, coverage, lint, and type-check caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
junit.xml
.testmondata
.tox/
.nox/
.mypy_cache/
.pyright/
.ruff_cache/
.hypothesis/

# Local Ratiocinatus workspaces, proof runs, exports, and qualification output
/.ratiocinatus/
/.demo/
/.demo-export/
/.phase0-proof/
/.phase0-export/
/.qualification/
/.verification/
/exports/
/tmp/
/temp/
*.fixture.zip

# Downloaded model weights and provider caches are never repository assets
/.cache/
/.huggingface/
/.torch/
/.whisper/
/models/
*.onnx
*.safetensors
*.gguf
*.ckpt
*.pth
*.pt

# Secrets and local configuration overrides
.env
.env.*
!.env.example
.envrc
.direnv/
.secrets/
.aws/
.azure/
.config/gcloud/
.netrc
_netrc
.npmrc
.pypirc
credentials.json
credentials.*.json
service-account*.json
secrets.json
secrets.*.json
*.secret
*.token
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
*.local.json
*.local.toml
*.local.yaml
*.local.yml

# Local databases and runtime state
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Operational logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~

# Local agent, editor, and operating-system metadata
.agents/
.codex/
.claude/
.idea/
.vscode/
.vs/
.DS_Store
.AppleDouble
.LSOverride
._*
