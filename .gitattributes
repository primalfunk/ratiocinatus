# Keep source and metadata text normalized across platforms.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf

# The canonical controlled proof corpus is intentionally versioned through LFS.
tests/fixtures/riverton_evening_access_v1/generation/line_audio/*.wav filter=lfs diff=lfs merge=lfs -text
tests/fixtures/riverton_evening_access_v1/media/**/*.flac filter=lfs diff=lfs merge=lfs -text
tests/fixtures/riverton_evening_access_v1/media/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
