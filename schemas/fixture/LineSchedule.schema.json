{
  "$defs": {
    "SpeakerRole": {
      "enum": [
        "MODERATOR",
        "PARTICIPANT_A",
        "PARTICIPANT_B"
      ],
      "title": "SpeakerRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "duration_microseconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Microseconds",
      "type": "integer"
    },
    "end_microseconds": {
      "exclusiveMinimum": 0,
      "title": "End Microseconds",
      "type": "integer"
    },
    "line_id": {
      "pattern": "^L\\d{3}$",
      "title": "Line Id",
      "type": "string"
    },
    "speaker_id": {
      "$ref": "#/$defs/SpeakerRole"
    },
    "start_microseconds": {
      "minimum": 0,
      "title": "Start Microseconds",
      "type": "integer"
    }
  },
  "required": [
    "line_id",
    "speaker_id",
    "start_microseconds",
    "duration_microseconds",
    "end_microseconds"
  ],
  "title": "LineSchedule",
  "type": "object"
}
